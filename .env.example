APP_NAME=A3 专科学习 AI
APP_VERSION=1.0.0
APP_ENV=development
# Production defaults to false. Set true only while migrating old API clients.
ENABLE_LEGACY_ROUTES=true

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_password
DATABASE_NAME=task_db2

# Used for authentication and encryption of saved user API keys. Keep it stable and secret.
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=168
AUTH_RATE_LIMIT_ENABLED=true
# Comma-separated CIDRs allowed to supply X-Forwarded-For.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# New users default to Asia/Shanghai and can change this via /api/v1/account/settings.

# Optional server-wide fallback. Users can configure any OpenAI-compatible provider in Settings.
DEEPSEEK_API_KEY=your_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Per-process Agent admission controls. Use a shared gateway for fleet-wide limits.
AGENT_MAX_CONCURRENT_STREAMS=8
AGENT_MAX_CONCURRENT_STREAMS_PER_USER=2
AGENT_REQUESTS_PER_MINUTE=30

# Durable automatic learning-memory worker. Users still opt in from Settings.
LEARNING_MEMORY_WORKER_ENABLED=true
LEARNING_MEMORY_WORKER_POLL_SECONDS=5
LEARNING_MEMORY_JOB_LEASE_SECONDS=180
LEARNING_MEMORY_JOB_MAX_ATTEMPTS=3
AUTO_MEMORY_MIN_CONFIDENCE=0.85
AUTO_MEMORY_MAX_PER_TURN=2
PROFILE_AGGREGATION_DEBOUNCE_SECONDS=300
PROFILE_MIN_MEMORY_COUNT=3
PROFILE_MIN_COURSE_COUNT=2

# 仅用于本地验收和 E2E；生产环境保持 false。
A3_MOCK_LLM=false
A3_MOCK_EMBEDDING=false
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# 默认模型 max_seq_length=128，为标题和特殊 token 预留空间。
RAG_CHUNK_TARGET_TOKENS=96
RAG_CHUNK_MAX_TOKENS=120
RAG_CHUNK_OVERLAP_TOKENS=20
# Query decomposition is experimental; coverage reranking is enabled by default.
RAG_ENABLE_MULTI_QUERY=false
RAG_ENABLE_COVERAGE_RERANK=true
# Complex-document ingestion. OCR requires a separate Tesseract installation.
RAG_OCR_MIN_PAGE_TEXT_CHARS=24
RAG_OCR_LANGUAGE=chi_sim+eng
RAG_OCR_DPI=200
RAG_OCR_TESSDATA=

# 可选依赖。缺失或不可用时只降级外部资源推荐，不影响核心学习闭环。
TAVILY_API_KEY=your_tavily_api_key
YOUTUBE_API_KEY=

# 统一工具平台的预留外部适配器。当前版本只报告配置状态，未执行真实外部调用。
A3_MCP_ENABLED=false
A3_MCP_ENDPOINT=
A3_IMAGE_TOOL_ENABLED=false
A3_IMAGE_TOOL_ENDPOINT=
EXTERNAL_RESOURCE_TIMEOUT_SECONDS=12
EXTERNAL_RESOURCE_CACHE_MINUTES=360
